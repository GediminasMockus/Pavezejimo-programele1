# Supabase project settings
# Copy this file to .env.local (or .env) and replace the placeholder values.
# Never commit real keys or the service_role key.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key

# Server-side only (configure in Vercel; never use VITE_ prefix)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
CRON_SECRET=replace_with_a_long_random_secret
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=Pavezejimo programele <notifications@your-verified-domain.lt>
APP_URL=https://pavezejimo-programele1.vercel.app
